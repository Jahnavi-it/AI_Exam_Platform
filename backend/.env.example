# Copy this file to .env
# Defaults to SQLite (zero setup). To use PostgreSQL instead, replace the
# DATABASE_URL below with something like:
# postgresql://<user>:<password>@localhost:5432/exam_platform
DATABASE_URL=sqlite:///./exam_platform.db
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Forgot/reset-password emails (Resend). Without a key, the reset token is
# still generated and reset-password still works via the link — just no
# email gets sent, which is fine for local dev.
RESEND_API_KEY=
FRONTEND_URL=http://localhost:3000

# --- Milestone 3 additions ---
# LLM-based subjective grading. Without this key, grading falls back to a
# deterministic keyword-overlap heuristic (clearly labelled in ai_justification)
# so the pipeline still runs end-to-end in dev/demo without a key.
ANTHROPIC_API_KEY=
ANTHROPIC_GRADING_MODEL=claude-sonnet-4-6

# Where uploaded image (handwritten) answers and thumbnails are stored.
UPLOAD_DIR=uploads

# --- Deployment ---
# Comma-separated list of deployed frontend URL(s) allowed to call this API
# (localhost is always allowed for dev, no need to list it here).
# e.g. ALLOWED_ORIGINS=https://exam-platform.vercel.app
ALLOWED_ORIGINS=
