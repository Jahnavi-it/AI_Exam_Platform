 }
+
+/* ---- Hero banner ---- */
+.hero-banner {
+  background: linear-gradient(135deg, #eef2ff 0%, #f5f3ff 55%, #ffffff 100%);
+  border: 1px solid #e5e7eb;
+  border-radius: 16px;
+  padding: 28px 32px;
+  margin-bottom: 24px;
+}
+.hero-eyebrow {
+  font-size: 12px;
+  font-weight: 700;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: #7c3aed;
+  margin: 0 0 6px;
+}
+.hero-banner h1 {
+  margin: 0 0 6px;
+  font-size: 26px;
+}
+.hero-banner p {
+  margin: 0 0 18px;
+  color: #6b7280;
+  font-size: 14px;
+}
+.hero-actions {
+  display: flex;
+  gap: 10px;
+  flex-wrap: wrap;
+}
+.btn-secondary {
+  padding: 10px 18px;
+  border-radius: 8px;
+  border: 1px solid #c7d2fe;
+  background: #fff;
+  color: #2563eb;
+  font-weight: 600;
+  font-size: 14px;
+  cursor: pointer;
+}
+.hero-actions .btn-primary,
+.hero-actions .btn-secondary {
+  width: auto;
+}
+
+/* ---- Quick access ---- */
+.quick-access-title {
+  font-size: 12px;
+  font-weight: 700;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+  color: #6b7280;
+  margin: 0 0 12px;
+}
+.quick-access-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
+  gap: 16px;
+}
+.quick-access-card {
+  display: flex;
+  align-items: flex-start;
+  gap: 14px;
+  background: #fff;
+  border: 1px solid #e5e7eb;
+  border-radius: 12px;
+  padding: 16px 18px;
+  text-decoration: none;
+  color: inherit;
+  transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
+  cursor: pointer;
+}
+.quick-access-card:hover {
+  transform: translateY(-2px);
+  box-shadow: 0 10px 22px rgba(20, 30, 60, 0.08);
+  border-color: #c7d2fe;
+}
+.quick-access-title-text {
+  font-weight: 700;
+  font-size: 14px;
+  margin-bottom: 2px;
+  color: #1f2530;
+}
+.quick-access-desc {
+  font-size: 12px;
+  color: #6b7280;
+}
+.quick-access-arrow {
+  margin-left: auto;
+  color: #9ca3af;
+  font-size: 18px;
+  align-self: center;
+}
+
+/* ---- Two column overview / submissions layout ---- */
+.overview-grid {
+  display: grid;
+  grid-template-columns: 1.1fr 1fr;
+  gap: 20px;
+}
+@media (max-width: 900px) {
+  .overview-grid { grid-template-columns: 1fr; }
+}
+
+.mini-stat-row {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 12px;
+  margin-bottom: 20px;
+}
+.mini-stat-box {
+  border: 1px solid #e5e7eb;
+  border-radius: 10px;
+  padding: 12px 14px;
+  text-align: left;
+}
+.mini-stat-label {
+  font-size: 11px;
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: 0.04em;
+  color: #9ca3af;
+  margin-bottom: 4px;
+}
+.mini-stat-value {
+  font-size: 22px;
+  font-weight: 700;
+  color: #1f2530;
+}
+
+.bar-row {
+  display: grid;
+  grid-template-columns: 110px 1fr 28px;
+  align-items: center;
+  gap: 10px;
+  margin-bottom: 10px;
+  font-size: 13px;
+}
+.bar-row-label {
+  color: #374151;
+  font-weight: 600;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+.bar-track {
+  background: #f1f3f8;
+  border-radius: 999px;
+  height: 8px;
+  overflow: hidden;
+}
+.bar-fill {
+  height: 100%;
+  border-radius: 999px;
+}
+.bar-row-count {
+  text-align: right;
+  color: #6b7280;
+  font-weight: 600;
+}
+
+.exam-list-item {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  border: 1px solid #e5e7eb;
+  border-radius: 10px;
+  padding: 12px 14px;
+  margin-bottom: 10px;
+}
+.exam-list-item .title {
+  font-weight: 700;
+  font-size: 14px;
+}
+.exam-list-item .subtitle {
+  font-size: 12px;
+  color: #6b7280;
+}
+.pill {
+  display: inline-block;
+  padding: 4px 10px;
+  border-radius: 999px;
+  font-size: 11px;
+  font-weight: 700;
+  text-transform: uppercase;
+}
+.pill-green { background: #d1fae5; color: #047857; }
+.pill-amber { background: #fef3c7; color: #b45309; }
+.pill-blue { background: #dbeafe; color: #1d4ed8; }
+.pill-purple { background: #ede9fe; color: #6d28d9; }
+.pill-gray { background: #f3f4f6; color: #4b5563; }
+
+/* ---- Submissions donut ---- */
+.donut-wrap {
+  display: flex;
+  align-items: center;
+  gap: 18px;
+  margin-bottom: 18px;
+}
+.donut-legend {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  font-size: 13px;
+}
+.donut-legend-item {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+.donut-legend-dot {
+  width: 9px;
+  height: 9px;
+  border-radius: 50%;
+  display: inline-block;
+}
+.donut-legend-value {
+  font-weight: 700;
+  margin-left: 4px;
+}
+.donut-caption {
+  font-size: 12px;
+  color: #9ca3af;
+  margin: -8px 0 16px;
+}
+
+.submission-row {
+  display: grid;
+  grid-template-columns: 1.3fr 1fr 1fr auto;
+  gap: 8px;
+  align-items: center;
+  padding: 10px 0;
+  border-bottom: 1px solid #f1f3f8;
+  font-size: 13px;
+}
+.submission-row .student-name {
+  font-weight: 700;
+}
+.submission-row .student-email,
+.submission-row .exam-subject {
+  font-size: 11px;
+  color: #9ca3af;
+}
+
+/* ---- Recent activity strip ---- */
+.activity-strip {
+  display: flex;
+  gap: 22px;
+  overflow-x: auto;
+  padding-bottom: 6px;
+}
+.activity-item {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  text-align: center;
+  min-width: 110px;
+}
+.activity-icon {
+  width: 42px;
+  height: 42px;
+  border-radius: 50%;
+  border: 1px solid #dbeafe;
+  color: #2563eb;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  font-size: 16px;
+  margin-bottom: 8px;
+}
+.activity-text {
+  font-size: 12px;
+  color: #374151;
+  line-height: 1.3;
+}
+.activity-time {
+  font-size: 11px;
+  color: #9ca3af;
+  margin-top: 4px;
+}
+
+.section-title-row {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  margin-bottom: 16px;
+}
+.section-title-row .section-title {
+  margin: 0;
+}
+.link-btn {
+  background: none;
+  border: none;
+  color: #2563eb;
+  font-weight: 600;
+  font-size: 13px;
+  cursor: pointer;
+  padding: 0;
+}
